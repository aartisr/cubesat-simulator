# Astroneer does not require environment variables for the default simulator or
# public context feeds. The optional values below belong only in Vercel Project
# Settings → Environment Variables. Never prefix a secret with VITE_.
# SPACE_TRACK_USERNAME=""
# SPACE_TRACK_PASSWORD=""
# EARTHDATA_TOKEN=""
# MISSION_TELEMETRY_API_URL="https://mission-gateway.example/telemetry"
# MISSION_TELEMETRY_BEARER_TOKEN=""
